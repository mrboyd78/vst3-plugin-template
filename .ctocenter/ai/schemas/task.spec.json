{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/mrboyd78/vst3-plugin-template/.ctocenter/schemas/task.spec.json",
  "title": "Task Specification",
  "description": "Schema for structured, actionable technical tasks generated by AI or created manually",
  "type": "object",
  "required": ["meta", "tasks"],
  "properties": {
    "meta": {
      "type": "object",
      "description": "Metadata about the task collection",
      "required": ["generated_at", "objective", "total_tasks"],
      "properties": {
        "generated_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of when tasks were generated"
        },
        "objective": {
          "type": "string",
          "description": "Original high-level objective or user story",
          "minLength": 10,
          "maxLength": 500
        },
        "total_tasks": {
          "type": "integer",
          "description": "Total number of tasks in this collection",
          "minimum": 1,
          "maximum": 50
        },
        "total_estimated_hours": {
          "type": "number",
          "description": "Sum of all task estimates in hours",
          "minimum": 0
        },
        "epic_id": {
          "type": "string",
          "description": "Optional ID linking to project management system"
        }
      }
    },
    "tasks": {
      "type": "array",
      "description": "Array of task objects",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["id", "title", "description", "priority", "estimate", "acceptance_criteria", "tags"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique task identifier (e.g., 'task-001', 'feature-auth-01')",
            "pattern": "^[a-z0-9-]+$",
            "minLength": 3,
            "maxLength": 50
          },
          "title": {
            "type": "string",
            "description": "Clear, actionable task title (imperative form)",
            "minLength": 10,
            "maxLength": 150
          },
          "description": {
            "type": "string",
            "description": "Detailed description with context, requirements, and implementation notes",
            "minLength": 20,
            "maxLength": 2000
          },
          "priority": {
            "type": "string",
            "description": "Task priority level",
            "enum": ["P0", "P1", "P2", "P3"],
            "pattern": "^P[0-3]$"
          },
          "estimate": {
            "type": "string",
            "description": "T-shirt size estimate",
            "enum": ["XS", "S", "M", "L", "XL"]
          },
          "estimated_hours": {
            "type": "number",
            "description": "Numeric estimate in hours (optional but recommended)",
            "minimum": 0.5,
            "maximum": 200
          },
          "dependencies": {
            "type": "array",
            "description": "Array of task IDs that must be completed before this task",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            },
            "uniqueItems": true
          },
          "acceptance_criteria": {
            "type": "array",
            "description": "Specific, testable criteria that define task completion",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 10,
              "maxLength": 300
            }
          },
          "tags": {
            "type": "array",
            "description": "Tags for categorization (component, type, scope)",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$",
              "minLength": 2,
              "maxLength": 30
            },
            "uniqueItems": true
          },
          "notes": {
            "type": "string",
            "description": "Optional implementation hints, considerations, or warnings",
            "maxLength": 1000
          },
          "assignee": {
            "type": "string",
            "description": "Optional: person or team assigned to this task",
            "maxLength": 100
          },
          "status": {
            "type": "string",
            "description": "Optional: current status of the task",
            "enum": ["backlog", "todo", "in-progress", "review", "done", "blocked"],
            "default": "backlog"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Optional: when task was created"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Optional: when task was last updated"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time",
            "description": "Optional: when task was completed"
          },
          "related_issues": {
            "type": "array",
            "description": "Optional: related GitHub issues or tickets",
            "items": {
              "type": "string"
            }
          },
          "related_prs": {
            "type": "array",
            "description": "Optional: related pull requests",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "priority_levels": {
      "P0": "Critical - Blockers, crashes, security vulnerabilities",
      "P1": "High - Important features, major bugs",
      "P2": "Medium - Enhancements, minor bugs",
      "P3": "Low - Nice-to-have, future improvements"
    },
    "estimate_guide": {
      "XS": "<2 hours - Simple changes, quick fixes",
      "S": "2-4 hours - Small features or fixes",
      "M": "1-2 days - Moderate features",
      "L": "3-5 days - Complex features",
      "XL": ">5 days - Should be broken down further"
    },
    "common_tags": {
      "component": ["audio", "gui", "parameters", "dsp", "state-management", "build", "ci-cd", "docs", "tests"],
      "type": ["feature", "bugfix", "refactor", "test", "documentation", "devops", "security", "performance"],
      "scope": ["frontend", "backend", "infrastructure", "tooling"]
    }
  },
  "examples": [
    {
      "meta": {
        "generated_at": "2025-11-09T10:00:00Z",
        "objective": "Add low-pass filter to plugin",
        "total_tasks": 3,
        "total_estimated_hours": 12
      },
      "tasks": [
        {
          "id": "lpf-001",
          "title": "Add filter parameters to parameter layout",
          "description": "Add 'cutoff' and 'resonance' parameters to AudioProcessorValueTreeState",
          "priority": "P1",
          "estimate": "S",
          "estimated_hours": 2,
          "dependencies": [],
          "acceptance_criteria": [
            "Parameters appear in generic editor",
            "Parameter values persist in DAW project"
          ],
          "tags": ["parameters", "feature", "audio"]
        }
      ]
    }
  ]
}
